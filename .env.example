# Database
POSTGRES_USER=doculens
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=doculens
DATABASE_URL=postgresql+asyncpg://doculens:your_secure_password_here@postgres:5432/doculens
SYNC_DATABASE_URL=postgresql://doculens:your_secure_password_here@postgres:5432/doculens

# Redis
REDIS_URL=redis://redis:6379/0

# Application
APP_NAME=DocuLens
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=info

# Server
HOST=0.0.0.0
PORT=8002

# Document storage
DOCUMENT_STORAGE_DIR=/app/storage/documents
MAX_UPLOAD_SIZE_BYTES=20971520

# Embeddings (local FastEmbed model, CPU inference)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_VERSION=1
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_STALE_SECONDS=3600
FASTEMBED_CACHE_DIR=/app/storage/fastembed
