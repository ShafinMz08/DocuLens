# Database
POSTGRES_USER=doculens
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=doculens
DATABASE_URL=postgresql+asyncpg://doculens:your_secure_password_here@postgres:5432/doculens
SYNC_DATABASE_URL=postgresql://doculens:your_secure_password_here@postgres:5432/doculens
TEST_DATABASE_URL=postgresql+asyncpg://doculens:your_secure_password_here@postgres:5432/doculens_test

# Redis
REDIS_URL=redis://redis:6379/0

# Application
APP_NAME=DocuLens
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=info

# Server
HOST=0.0.0.0
PORT=8000

# CORS - comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Document storage
DOCUMENT_STORAGE_DIR=/app/storage/documents
MAX_UPLOAD_SIZE_BYTES=20971520

# Embeddings (local FastEmbed model, CPU inference)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_VERSION=1
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_STALE_SECONDS=3600
FASTEMBED_CACHE_DIR=/app/storage/fastembed

# LLM providers (Phase 4 - RAG question answering)
# Get a Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Get a Groq key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=60

# RAG / chat
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.2
RAG_MAX_CONTEXT_CHARS=12000
CHAT_HISTORY_LIMIT=10
CHAT_MAX_QUESTION_LENGTH=4000
